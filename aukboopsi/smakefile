$(BUILDDIR)/class_trackarea_lib.o: TrackArea/class_trackarea_lib.c $(BUILDDIR)
	sc TrackArea/class_trackarea_lib.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_trackarea_render.o: TrackArea/class_trackarea_render.c $(BUILDDIR)
	sc TrackArea/class_trackarea_render.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_trackarea_handleinput.o: TrackArea/class_trackarea_handleinput.c $(BUILDDIR)
	sc TrackArea/class_trackarea_handleinput.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

# TrackListArea class
$(BUILDDIR)/class_tracklistarea_attribs.o: TrackListArea/class_tracklistarea_attribs.c $(BUILDDIR)
	sc TrackListArea/class_tracklistarea_attribs.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_tracklistarea_dispatch.o: TrackListArea/class_tracklistarea_dispatch.c $(BUILDDIR)
	sc TrackListArea/class_tracklistarea_dispatch.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_tracklistarea_lib.o: TrackListArea/class_tracklistarea_lib.c $(BUILDDIR)
	sc TrackListArea/class_tracklistarea_lib.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_tracklistarea_render.o: TrackListArea/class_tracklistarea_render.c $(BUILDDIR)
