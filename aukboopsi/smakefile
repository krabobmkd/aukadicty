$(BUILDDIR)/class_trackarea_attribs.o: TrackArea/class_trackarea_attribs.c $(BUILDDIR)
	sc TrackArea/class_trackarea_attribs.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_trackarea_dispatch.o: TrackArea/class_trackarea_dispatch.c $(BUILDDIR)
