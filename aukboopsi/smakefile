# Link executable
$(BUILDDIR)/aukadicty: $(OBJS) //build-sasc/libaukproject.lib
	slink FROM LIB:c.o $(OBJS) //build-sasc/libaukproject.lib LIB $(LIBS) TO $@

clean:
	-delete ALL FORCE $(BUILDDIR)
