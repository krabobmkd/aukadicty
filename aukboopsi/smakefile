	sc TrackListArea/class_tracklistarea_handleinput.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

# TimeRule class
$(BUILDDIR)/class_timerule_attribs.o: TimeRule/class_timerule_attribs.c $(BUILDDIR)
	sc TimeRule/class_timerule_attribs.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_timerule_dispatch.o: TimeRule/class_timerule_dispatch.c $(BUILDDIR)
	sc TimeRule/class_timerule_dispatch.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_timerule_lib.o: TimeRule/class_timerule_lib.c $(BUILDDIR)
	sc TimeRule/class_timerule_lib.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_timerule_render.o: TimeRule/class_timerule_render.c $(BUILDDIR)
	sc TimeRule/class_timerule_render.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_timerule_handleinput.o: TimeRule/class_timerule_handleinput.c $(BUILDDIR)
	sc TimeRule/class_timerule_handleinput.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

# TrackHeader class
$(BUILDDIR)/class_trackheader_attribs.o: TrackHeader/class_trackheader_attribs.c $(BUILDDIR)
	sc TrackHeader/class_trackheader_attribs.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_trackheader_dispatch.o: TrackHeader/class_trackheader_dispatch.c $(BUILDDIR)
	sc TrackHeader/class_trackheader_dispatch.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_trackheader_render.o: TrackHeader/class_trackheader_render.c $(BUILDDIR)
	sc TrackHeader/class_trackheader_render.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_trackheader_lib.o: TrackHeader/class_trackheader_lib.c $(BUILDDIR)
	sc TrackHeader/class_trackheader_lib.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

# VolumeRule class
$(BUILDDIR)/class_volumerule_attribs.o: VolumeRule/class_volumerule_attribs.c $(BUILDDIR)
	sc VolumeRule/class_volumerule_attribs.c $(SCOPTS) $(STATICDEFS) OBJNAME=$@

$(BUILDDIR)/class_volumerule_dispatch.o: VolumeRule/class_volumerule_dispatch.c $(BUILDDIR)
